{
  "kind": "collectionType",
  "collectionName": "club_memberships",
  "info": {
    "singularName": "club-membership",
    "pluralName": "club-memberships",
    "displayName": "Club Membership"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "member_role": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "default": "guest",
      "enum": [
        "owner",
        "admin",
        "member",
        "guest"
      ]
    },
    "activity_club": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::activity-club.activity-club",
      "inversedBy": "club_memberships"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "club_memberships"
    }
  }
}
